# 学面通 AI · docker compose 环境模板
#
# 复制为 .env.docker 后填写真实值（.env.docker 已被 .gitignore 忽略，不会入库）：
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
#
# 规则：
#   - 所有 docker compose 命令都必须带 --env-file .env.docker，本文件同时用于变量插值；
#   - 值不要包含空格、$、#、引号；数据库口令建议只用字母数字；
#   - 生产环境请把下方 change_me_* 全部替换为随机值，JWT_SECRET 至少 32 位。

# ---- 站点地址（Caddyfile）----
# 本地试跑：写 http:// 前缀关闭自动 HTTPS，并把两个域名加入 /etc/hosts 指向 127.0.0.1
SITE_APP=http://study.localhost
SITE_STORAGE=http://storage.localhost
# 生产环境改成纯域名（Caddy 自动申请 / 续期证书，80/443 必须对公网可达）：
# SITE_APP=study.example.com
# SITE_STORAGE=storage.example.com
#
# MinIO 公开域名（与 SITE_STORAGE 的主机名保持一致，不要带协议和端口）：
# 后端用它生成预签名 URL，容器内会把该域名解析到 Caddy 网关再回源 MinIO。
MINIO_PUBLIC_HOST=storage.localhost
# 生产 HTTPS 必须置为 true（与 SITE_STORAGE 的 https 保持一致）
MINIO_SECURE=false

# ---- 运行环境 ----
# prod：关闭 /docs 与 /openapi.json；本地想开文档可临时改成 dev
APP_ENV=prod
LOG_LEVEL=WARNING
LOG_TO_CONSOLE=false

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=study_pass
MYSQL_USER=study_pass
MYSQL_PASSWORD=change_me_mysql_app

# ---- Redis（同时承担限流计数与缓存）----
REDIS_PASSWORD=change_me_redis
REDIS_DB=1

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_admin
MINIO_BUCKET=ai-resource

# ---- JWT ----
# 生成示例：openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# ---- 大模型（OpenAI 兼容）----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
INTERVIEW_EVAL_AUTO=true

# ---- 上传 / 限流（可选，保持默认即可）----
# FILE_MAX_BYTES=10485760
# AVATAR_MAX_BYTES=2097152
# RATE_LIMIT_CHAT_MAX=20
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_WORKFLOW_MAX=5

# ---- RAG 向量化与知识卡 / OCR / 语音面试 ----
DASHSCOPE_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-4-0-250828
SEEDREAM_IMAGE_SIZE=1728x2304
PODCAST_TTS_APP_ID=
PODCAST_TTS_ACCESS_KEY=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_REGION=cn-north-1
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=

# ---- 构建加速（可选）----
# 国内构建可换成镜像源，例如：
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
# 本地向量模型下载镜像；使用镜像时必须保持 HF_HUB_DISABLE_XET=1（compose 已内置）
HF_ENDPOINT=https://hf-mirror.com
