# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境（.venv 内已有 .gitignore，此处兜底其他命名）
.venv/
venv/
env/

# 本地环境变量与敏感配置（保留 *.example 模板入库，真实文件不入库）
.env
.env.local
.env.*
!.env.example
!.env.dev.example
!.env.prod.example

# 日志输出（运行期生成，不入库）
logs/
*.log

# 上传文件（运行期生成，不入库）
uploads/

# 系统 / 编辑器
.DS_Store
