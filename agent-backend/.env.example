# ===== 基础 / 共享配置（.env）=====
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会入库）。
# 分层规则（见 AGENTS.md §5）：真实环境变量 > .env.{APP_ENV} > .env。

# 运行环境：dev（默认）/ prod，决定叠加哪个环境专属文件 .env.{APP_ENV}
APP_ENV=dev

# MySQL 连接串：SQLAlchemy 同步驱动 pymysql，务必带 charset=utf8mb4
MYSQL_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/study_pass?charset=utf8mb4

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO

# JWT 签名密钥：必填，缺失时服务启动即报错。请改成足够长的随机串
# （生产环境建议用真实环境变量注入，勿写入 .env.prod）。
JWT_SECRET=please_change_this_to_a_long_random_string

# 可选：签名算法与令牌有效期（不填用默认值）
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# 可选：上传文件根目录（相对路径锚定 agent-backend/，默认 uploads，已 gitignore）
# UPLOAD_DIR=uploads
# 通用文档大小上限（字节，默认 10MB）
# FILE_MAX_BYTES=10485760
# 图片（会写入头像）大小上限（字节，默认 2MB）
# AVATAR_MAX_BYTES=2097152

# MinIO 对象存储（必填；原文件落桶，元数据存 MySQL resources 表）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-resource
MINIO_SECURE=false
# 预签名 URL 有效期（秒，默认 7 天，MinIO 上限）；历史消息读取时会自动续签
# MINIO_PRESIGN_EXPIRE_SECONDS=604800

# ===== Seedream 文生图（难点知识卡）=====
# 密钥只走环境变量；缺失时仅知识卡接口返回 503，不影响其他功能。
# SEEDREAM_API_KEY=sk-xxxx
# 火山方舟图片生成地址（默认即此地址）
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID 或推理接入点 ID（ep-...），必须与 API Key 所属账号 / 项目已开通的版本一致
# SEEDREAM_MODEL=doubao-seedream-4-0-250828
# 出图尺寸：WIDTHxHEIGHT 或 2k / 3k / 4k；默认 1728x2304 竖版
# SEEDREAM_IMAGE_SIZE=1728x2304
# 单次出图 / 下载超时（秒）
# SEEDREAM_TIMEOUT=120

# ===== 火山语音播客大模型（知识卡语音讲解）=====
# 凭证来自语音控制台（App ID + Access Key，不是 RTC）；缺失时知识卡只跳过音频。
# PODCAST_TTS_APP_ID=
# PODCAST_TTS_ACCESS_KEY=
# 播客接口为 WebSocket 二进制协议（控制台「语音播客」文档）
# PODCAST_TTS_BASE_URL=wss://openspeech.bytedance.com
# PODCAST_TTS_PATH=/api/v3/sami/podcasttts
# PODCAST_TTS_RESOURCE_ID=volc.service_type.10050
# 单次播客生成超时（秒）
# PODCAST_TTS_TIMEOUT=300

# ===== AI 对话（OpenAI 兼容协议）=====
# provider 仅决定 base_url 默认值：openai / deepseek / qwen / moonshot / zhipu
# 其他兼容 OpenAI 协议的服务请显式配置 LLM_BASE_URL
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=0.7
# 单次请求超时（秒）与失败重试次数
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=1

# 记忆层：带入上下文的最近轮数（一问一答算一轮）与单条消息最大字符数
# MEMORY_MAX_TURNS=8
# MEMORY_MESSAGE_MAX_CHARS=4000

# ===== 提示词版本管理（Redis 缓存）=====
# 生效模板以 MySQL prompt_templates 为唯一数据源，Redis 仅做缓存；
# Redis 不可用时自动回源数据库，不影响接口可用性。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# 默认 db1，与其他项目常用的 db0 隔离（同实例多项目时按需调整）
# REDIS_DB=1
# REDIS_PASSWORD=
# 缓存 Key（Hash）：字段为 `{agent_name}:{scene}`，公共模板为 `common:{scene}`
# PROMPT_CACHE_KEY=prompt:templates:active

# ===== 接口限流（Redis 集中式固定窗口）=====
# 计数后端：redis（多实例共享）/ memory（仅进程内，测试或单机调试）
# Redis 不可用时自动降级为进程内限流，并每 RATE_LIMIT_FALLBACK_LOG_INTERVAL 秒最多告警一次
# RATE_LIMIT_BACKEND=redis
# 窗口长度（秒）与各接口单窗口配额
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_CHAT_MAX=20
# RATE_LIMIT_TASK_MAX=10
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_WORKFLOW_MAX=5
# Redis key 前缀：{prefix}:{scope}:{user_id | 真实IP}
# RATE_LIMIT_KEY_PREFIX=ratelimit
# RATE_LIMIT_FALLBACK_LOG_INTERVAL=30

# ===== RAG 知识库向量化 =====
# DashScope 文本向量化密钥（text-embedding-v4，1024 维）
# DASHSCOPE_API_KEY=sk-xxxx
# Qdrant 服务地址（collection 固定 knowledge_chunks，不存在时自动创建）
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333

# ===== 火山 RTC 语音面试（AI 面试官）=====
# 应用凭证只走环境变量；未配置时面试仍可创建，只是不启动 AI、不返回入房 token。
# 复用上面的 VOLC_ACCESS_KEY / VOLC_SECRET_KEY / VOLC_REGION 调用 RTC OpenAPI。
# VOLC_RTC_APP_ID=your_rtc_app_id
# VOLC_RTC_APP_KEY=your_rtc_app_key
# 前端入房 token 有效期（秒，默认 6 小时）
# VOLC_RTC_TOKEN_TTL_SECONDS=21600
# 豆包语音合成音色；如 RTC 控制台使用自定义账号，可再填 TTS 凭证
# VOLC_RTC_TTS_SPEAKER=zh_female_linjianvhai_moon_bigtts
# VOLC_RTC_TTS_APP_ID=
# VOLC_RTC_TTS_ACCESS_TOKEN=
# 流式语音识别凭证（bigmodel 模式需要）
# VOLC_RTC_ASR_APP_ID=
# VOLC_RTC_ASR_ACCESS_TOKEN=
# 判停：静音超过该时长（毫秒，[500,3000)）才判定用户本轮说完，默认 1500；
# AIVAD 开启语义判停（语义不完整时最多等到静音 2 秒），默认开启。
# VOLC_RTC_VAD_SILENCE_TIME_MS=1500
# VOLC_RTC_AIVAD=true
# AI 面试官开场白 / LLM 历史轮数 / 静默超时（秒）/ 字幕开关
# VOLC_RTC_WELCOME_MESSAGE=你好，我是本场面试的 AI 面试官，我们现在开始。
# VOLC_RTC_HISTORY_LENGTH=10
# VOLC_RTC_IDLE_TIMEOUT=180
# VOLC_RTC_SUBTITLE_MODE=0

# ===== 本地向量模型下载（fastembed / huggingface_hub）=====
# 使用国内镜像 HF_ENDPOINT=https://hf-mirror.com 时必须禁用 Xet：镜像不代理
# CAS 服务器会导致模型下载 401（启动时语义预热报 RuntimeError）。
HF_HUB_DISABLE_XET=1


