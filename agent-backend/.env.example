# ===== 基础 / 共享配置（.env）=====
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会入库）。
# 分层规则（见 AGENTS.md §5）：真实环境变量 > .env.{APP_ENV} > .env。

# 运行环境：dev（默认）/ prod，决定叠加哪个环境专属文件 .env.{APP_ENV}
APP_ENV=dev

# MySQL 连接串：SQLAlchemy 同步驱动 pymysql，务必带 charset=utf8mb4
MYSQL_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/study_pass?charset=utf8mb4

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO

# JWT 签名密钥：必填，缺失时服务启动即报错。请改成足够长的随机串
# （生产环境建议用真实环境变量注入，勿写入 .env.prod）。
JWT_SECRET=please_change_this_to_a_long_random_string

# 可选：签名算法与令牌有效期（不填用默认值）
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# 可选：上传文件根目录（相对路径锚定 agent-backend/，默认 uploads，已 gitignore）
# UPLOAD_DIR=uploads
# 通用文档大小上限（字节，默认 10MB）
# FILE_MAX_BYTES=10485760
# 图片（会写入头像）大小上限（字节，默认 2MB）
# AVATAR_MAX_BYTES=2097152

# MinIO 对象存储（必填；原文件落桶，元数据存 MySQL resources 表）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-resource
MINIO_SECURE=false

# ===== AI 对话（OpenAI 兼容协议）=====
# provider 仅决定 base_url 默认值：openai / deepseek / qwen / moonshot / zhipu
# 其他兼容 OpenAI 协议的服务请显式配置 LLM_BASE_URL
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=0.7
# 单次请求超时（秒）与失败重试次数
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=1

# 记忆层：带入上下文的最近轮数（一问一答算一轮）与单条消息最大字符数
# MEMORY_MAX_TURNS=10
# MEMORY_MESSAGE_MAX_CHARS=4000

# ===== 提示词版本管理（Redis 缓存）=====
# 生效模板以 MySQL prompt_templates 为唯一数据源，Redis 仅做缓存；
# Redis 不可用时自动回源数据库，不影响接口可用性。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# 默认 db1，与其他项目常用的 db0 隔离（同实例多项目时按需调整）
# REDIS_DB=1
# REDIS_PASSWORD=
# 缓存 Key（Hash）：字段为 `{agent_name}:{scene}`，公共模板为 `common:{scene}`
# PROMPT_CACHE_KEY=prompt:templates:active
