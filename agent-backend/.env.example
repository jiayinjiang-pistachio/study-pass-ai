# ===== 基础 / 共享配置（.env）=====
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会入库）。
# 分层规则（见 AGENTS.md §5）：真实环境变量 > .env.{APP_ENV} > .env。

# 运行环境：dev（默认）/ prod，决定叠加哪个环境专属文件 .env.{APP_ENV}
APP_ENV=dev

# MySQL 连接串：SQLAlchemy 同步驱动 pymysql，务必带 charset=utf8mb4
MYSQL_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/study_pass?charset=utf8mb4

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO
