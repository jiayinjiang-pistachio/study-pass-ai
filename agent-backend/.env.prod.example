# ===== 生产环境覆盖（.env.prod）=====
# 复制为 .env.prod；只需写要覆盖的项，其余继承 .env。
# 生产只落文件留痕、不输出控制台，级别收敛到 WARNING，避免多余日志。
LOG_LEVEL=WARNING
LOG_TO_CONSOLE=false

# 生产敏感值（如 MYSQL_URL、JWT_SECRET）建议直接用真实环境变量注入，勿写入本文件。
# MYSQL_URL=mysql+pymysql://user:password@host:3306/study_pass?charset=utf8mb4
# JWT_SECRET=<用真实环境变量注入，勿落盘>
